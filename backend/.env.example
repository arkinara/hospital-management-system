# Copy to backend/.env and adjust. Every value has a working default
# in app/config.py, so the app boots without this file.

# Environment: development | test | production
ENVIRONMENT=development

# Git SHA the build was cut from. Falls back to "dev" when unset.
BUILD_SHA=dev

# SQLite file shared with the frontend Drizzle workspace. Relative paths
# resolve against backend/. Default: db/hospital.db
DATABASE_PATH=db/hospital.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# ---- Auth / tokens ---------------------------------------------------------
# HS256 signing secret for access tokens. REQUIRED in production. If unset in
# development, a random per-startup secret is generated (sessions do not
# survive restarts).
JWT_SECRET=
# JWT signing algorithm.
JWT_ALGORITHM=HS256
# Access token lifetime in minutes.
ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token lifetime in days.
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt cost factor for password hashing (>=12 recommended).
BCRYPT_ROUNDS=12