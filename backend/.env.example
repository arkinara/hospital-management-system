# Copy to backend/.env and adjust. Every value has a working default
# in app/config.py, so the app boots without this file.

# Environment: development | test | production
ENVIRONMENT=development

# Git SHA the build was cut from. Falls back to "dev" when unset.
BUILD_SHA=dev

# SQLite file shared with the frontend Drizzle workspace. Relative paths
# resolve against backend/. Default: db/hospital.db
DATABASE_PATH=db/hospital.db

# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000